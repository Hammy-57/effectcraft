{
  "id": "fix-layout",
  "title": "Fix the layout problems",
  "prompt": "The comp \"Main\" (1920×1080) has layout problems: the text layer \"Headline\" is cut off at the frame edge and the text layer \"Fine print\" is tiny and outside the safe area. Fix them so render.lint reports no errors or warnings: both texts fully inside the title-safe area, \"Fine print\" at a legible size (render.lint wants characters at least 1/30 of the frame height, 36 px here) and \"Headline\" at least 60 px tall. The title-safe area is the frame inset by 10% on each side (x 192–1728, y 108–972 in a 1920×1080 comp). Don't delete layers or change the wording.",
  "setup": [
    {
      "command": "comp.new",
      "params": {
        "name": "Main",
        "width": 1920,
        "height": 1080,
        "frameRate": 30,
        "duration": 5
      }
    },
    {
      "command": "layer.newText",
      "params": {
        "text": "BREAKING",
        "size": 120,
        "position": [
          1750,
          90
        ],
        "fill": "#FFFFFF",
        "name": "Headline"
      }
    },
    {
      "command": "layer.newText",
      "params": {
        "text": "Terms apply",
        "size": 12,
        "position": [
          1700,
          1060
        ],
        "fill": "#FFFFFF",
        "name": "Fine print"
      }
    }
  ],
  "limits": {
    "minutes": 10,
    "toolCalls": 40
  },
  "checks": [
    {
      "id": "safe",
      "desc": "both texts inside title-safe",
      "query": "layer.bounds",
      "params": {
        "comp": "Main",
        "layers": [
          "Headline",
          "Fine print"
        ]
      },
      "expect": [
        {
          "path": "/layers",
          "op": "len",
          "value": 2
        },
        {
          "path": "/layers",
          "op": "all",
          "value": [
            {
              "path": "/visible",
              "op": "eq",
              "value": true
            },
            {
              "path": "/corners",
              "op": "all",
              "value": [
                {
                  "path": "/0",
                  "op": "gte",
                  "value": 192
                },
                {
                  "path": "/0",
                  "op": "lte",
                  "value": 1728
                },
                {
                  "path": "/1",
                  "op": "gte",
                  "value": 108
                },
                {
                  "path": "/1",
                  "op": "lte",
                  "value": 972
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "fine-size",
      "desc": "Fine print at least 20 px tall",
      "query": "layer.bounds",
      "params": {
        "comp": "Main",
        "layers": [
          "Fine print"
        ]
      },
      "select": {
        "array": "/layers",
        "index": 0
      },
      "expect": [
        {
          "path": "/bounds/3",
          "op": "gte",
          "value": 20
        }
      ]
    },
    {
      "id": "headline-size",
      "desc": "Headline at least 60 px tall",
      "query": "layer.bounds",
      "params": {
        "comp": "Main",
        "layers": [
          "Headline"
        ]
      },
      "select": {
        "array": "/layers",
        "index": 0
      },
      "expect": [
        {
          "path": "/bounds/3",
          "op": "gte",
          "value": 60
        }
      ]
    },
    {
      "id": "headline-text",
      "desc": "Headline wording unchanged",
      "prop": {
        "comp": "Main",
        "layer": "Headline",
        "path": "text/sourceText"
      },
      "op": "eq",
      "value": "BREAKING"
    },
    {
      "id": "fine-text",
      "desc": "Fine print wording unchanged",
      "prop": {
        "comp": "Main",
        "layer": "Fine print",
        "path": "text/sourceText"
      },
      "op": "eq",
      "value": "Terms apply"
    },
    {
      "layerCount": {
        "comp": "Main"
      },
      "id": "count",
      "desc": "still two layers",
      "op": "eq",
      "value": 2
    },
    {
      "id": "clean",
      "desc": "render.lint finds no errors or warnings",
      "lint": {
        "comp": "Main"
      }
    }
  ],
  "solution": [
    {
      "command": "prop.set",
      "params": {
        "layer": "Headline",
        "path": "transform/position",
        "value": [
          960,
          300,
          0
        ]
      }
    },
    {
      "command": "layer.setText",
      "params": {
        "layer": "Fine print",
        "size": 40
      }
    },
    {
      "command": "prop.set",
      "params": {
        "layer": "Fine print",
        "path": "transform/position",
        "value": [
          960,
          900,
          0
        ]
      }
    }
  ]
}
